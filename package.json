    "test:rules": "vitest run tests/rules"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "firebase": "^13.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "firebase-tools": "^15.34.2",
    "protobufjs": "^7.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "^3.2.4"
  }
}
